#!/usr/bin/env bash
# Runs every 5min: show zenity dialogs for due reminders in ~/.reminders/

REMINDERS_DIR="$HOME/.reminders"
[[ -d "$REMINDERS_DIR" ]] || exit 0

# include paths that cron doesnt have
export PATH="$HOME/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# Set up display vars that cron doesnt have
if [[ -z "${DISPLAY:-}" ]]; then
    for lock in /tmp/.X*-lock; do
        num="${lock##*/X}"; num="${num%%-lock}"
        [[ "$num" =~ ^[0-9]+$ ]] && export DISPLAY=":$num" && break
    done
    export DISPLAY="${DISPLAY:-:0}"
fi
uid=$(id -u)
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$uid/bus}"

if ! command -v zenity &>/dev/null; then
    echo "$(date): zenity not found, skipping" >> "$REMINDERS_DIR/check.log"
    exit 0
fi
if ! command -v jq &>/dev/null; then
    echo "$(date): jq not found, skipping" >> "$REMINDERS_DIR/check.log"
    exit 0
fi

NOW=$(date +%s)
shopt -s nullglob

for file in "$REMINDERS_DIR"/*.json; do
    ts=$(basename "$file" .json | cut -d- -f1)
    [[ "$ts" =~ ^[0-9]+$ ]]     || continue
    (( ts <= NOW ))             || continue

    title=$(jq -r .title       "$file")
    description=$(jq -r .description "$file")
    content=$(jq -r .content   "$file")

    result=$(zenity --question \
        --title="Reminder: $title" \
        --text="$description" \
        --ok-label="Open" \
        --cancel-label="Dismiss" \
        --extra-button="Snooze 5min" \
        --width=420 2>/dev/null)
    rc=$?

    if [[ $rc -eq 0 ]]; then # Open
        tmp=$(mktemp /tmp/reminder-XXXXXX.txt)
        printf '=== %s ===\n\n%s\n\n---\n\n%s\n' "$title" "$description" "$content" > "$tmp"

        terminal="$(command -v "${TERMINAL%% *}" 2>/dev/null \
            || command -v kitty 2>/dev/null \
            || command -v gnome-terminal 2>/dev/null \
            || command -v konsole 2>/dev/null \
            || command -v xfce4-terminal 2>/dev/null \
            || command -v x-terminal-emulator 2>/dev/null \
            || echo xterm)"
        editor="${VISUAL:-${EDITOR:-$(command -v nvim 2>/dev/null || command -v vim 2>/dev/null || echo nano)}}"
        case "$(basename "$terminal")" in
            kitty)                           "$terminal" --single-instance -- "$editor" "$tmp" & ;;
            xterm|xfce4-terminal|lxterminal) "$terminal" -e "$editor $tmp" & ;;
            *) "$terminal" -- "$editor" "$tmp" & ;;
        esac
        rm "$file"

    elif [[ "$result" == "Snooze 5min" ]]; then # Snooze
        :
    else # Dismiss or window closed
        rm "$file"
    fi
done
